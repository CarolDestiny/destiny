# destiny 代码格式化配置 —— clang-format
# 用法：
#   clang-format -i <file>            # 原地格式化
#   clang-format --dry-run --Werror <file>  # 只检查不修改
# 批量格式化全部源码：
#   find source -name "*.cpp" -o -name "*.hpp" | xargs clang-format -i

BasedOnStyle: LLVM

# ---- 缩进与空格 ----
IndentWidth: 4                    # 4 空格缩进
UseTab: Never                     # 全用空格，禁用 Tab
ContinuationIndentWidth: 4        # 续行缩进与代码缩进一致
AlignAfterOpenBracket: Align      # 括号内多行参数对齐到开括号
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false

# ---- 大括号与换行 ----
# Custom 模式 + BraceWrapping：
#   if/while/for 等控制语句大括号跟随（不换行，if (x) {）
#   函数/类/命名空间大括号独立成行（Allman 风格）
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Never      # if/while/for 大括号跟随
  AfterFunction: true               # 函数体大括号独立成行
  AfterClass: false                 # 类体大括号不独立成行
  AfterNamespace: false             # 命名空间大括号不独立成行
  BeforeElse: true                  # else 独立成行
  BeforeCatch: true                 # catch 独立成行
  AfterStruct: false
  AfterEnum: true
  AfterUnion: true
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
BreakBeforeBinaryOperators: NonAssignment
BinPackArguments: true
BinPackParameters: true
AlwaysBreakTemplateDeclarations: Yes # 所有template后强制换行

# ---- 命名空间与类 ----
NamespaceIndentation: All         # 命名空间内容缩进
AccessModifierOffset: -4          # public:/private: 与 class 对齐
IndentCaseLabels: false           # case 不额外缩进，与 switch 对齐
FixNamespaceComments: false       # namespace自动注释

# ---- 指针、排序与杂项 ----
PointerAlignment: Left            # int* p
SpaceBeforeParens: ControlStatements  # if (x) 有空格，f(x) 无空格
SortIncludes: CaseSensitive
IncludeCategories:
  - Regex: '^"destiny/'           # 项目头优先
    Priority: 1
  - Regex: '^<gtest|^<gmock'      # gtest/gmock
    Priority: 2
  - Regex: '.*'                   # 其余（标准库等）
    Priority: 3
MaxEmptyLinesToKeep: 1

# ---- 行宽 ----
ColumnLimit: 120                  # 上限 120（写作时尽量压 80）
