# ============ 构建产物 ============
# CMake 构建目录（多个 preset 各自独立，全部忽略）
/build/

# 产物输出目录（可执行文件、库）
/bin/

# ============ 运行时数据 ============
# 程序运行期缓存（如 dlopen 缓存的引擎文件）。
# 忽略 cache 下所有内容，但保留目录本身（.gitkeep 占位）
/cache/*
!/cache/.gitkeep

# ============ IDE / 编辑器 ============
.idea/
.vscode/
.vs/
*.swp
*.swo
*~

# ============ 系统文件 ============
.DS_Store
Thumbs.db
